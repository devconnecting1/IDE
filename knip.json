{
  "$schema": "https://knip.dev/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": ["src/app/**/page.tsx", "src/app/**/layout.tsx"],
      "ignore": [
        "src/components/animate-ui/**",
        "src/components/ui/**",
        "src/hooks/use-controlled-state.tsx",
        "src/components/date-range-picker.tsx",
        "src/data/countries.ts",
        "src/data/timezones.ts",
        "src/hooks/use-is-in-view.tsx",
        "src/lib/get-strict-context.tsx",
        "src/styles/flag-icons/flags.css"
      ],
      "ignoreDependencies": [
        "@base-ui/react",
        "@floating-ui/react",
        "@workspaacing/ui",
        "@workspaacing/theme",
        "d3-geo",
        "@types/d3-geo",
        "topojson-client",
        "@types/topojson-client",
        "embla-carousel-react",
        "input-otp",
        "motion",
        "next-themes",
        "react-day-picker",
        "react-markdown",
        "recharts",
        "shiki"
      ]
    },
    "apps/desktop": {
      "entry": ["electron/main.ts", "electron/preload.ts"]
    },
    "apps/mobile": {
      "entry": ["src-tauri/src/lib.rs"],
      "ignoreDependencies": ["@tauri-apps/api", "@tauri-apps/plugin-shell"]
    },
    "packages/ui": {
      "ignoreDependencies": ["@floating-ui/react", "@hookform/resolvers", "@tanstack/react-table", "motion", "react-hook-form", "shiki"]
    },
    "packages/theme": {
      "ignore": ["src/generate-theme-presets.ts"]
    }
  },
  "ignoreBinaries": ["yamllint"],
  "ignoreDependencies": ["lint-staged"],
  "ignoreIssues": {
    "apps/web/src/app/(main)/dashboard/_components/header/account-dialog.tsx": ["exports"],
    "apps/web/src/lib/utils.ts": ["exports"]
  },
  "exclude": ["enumMembers", "namespaceMembers", "types"]
}
