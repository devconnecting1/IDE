{
  "name": "studio-admin",
  "version": "2.2.0",
  "private": true,
  "main": "electron/dist/main.js",
  "author": {
    "name": "Studio Admin",
    "email": "dev@studioadmin.app"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:local:build": "node scripts/ci-local.mjs --build",
    "knip": "knip",
    "lint:md": "markdownlint-cli2 \"*.md\"",
    "lint:yaml": "yamllint .github/workflows/*.yml .github/dependabot.yml",
    "electron:build:ts": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build:ts && electron .",
    "electron:build": "npm run electron:build:ts && electron-builder",
    "electron:build:win": "npm run electron:build:ts && electron-builder --win",
    "electron:build:mac": "npm run electron:build:ts && electron-builder --mac",
    "electron:build:linux": "npm run electron:build:ts && electron-builder --linux"
  },
  "build": {
    "appId": "com.studioadmin.app",
    "productName": "Studio Admin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/dist/**/*",
      "electron/interface.d.ts",
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/app/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/app/favicon.ico",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/app/favicon.ico",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.yml": [
      "bash -c 'pip install -q yamllint && yamllint -c .yamllint.yml'"
    ]
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@swc/core": true
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@floating-ui/react": "^0.27.20",
    "@fullcalendar/react": "^7.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "simple-icons": "^16.29.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.4",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
