{
  "name": "@workspaacing/desktop",
  "version": "2.2.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run electron:build:ts && electron .",
    "build": "npm run electron:build:ts",
    "electron:package": "npm run electron:build:ts && electron-builder",
    "electron:package:win": "npm run electron:build:ts && electron-builder --win",
    "electron:package:mac": "npm run electron:build:ts && electron-builder --mac",
    "electron:package:linux": "npm run electron:build:ts && electron-builder --linux",
    "electron:build:ts": "tsc -p electron/tsconfig.json"
  },
  "build": {
    "appId": "com.workspaacing.app",
    "productName": "Workspaacing",
    "directories": {
      "output": "dist-electron"
    },
    "files": ["electron/dist/**/*", "electron/interface.d.ts", "out/**/*"],
    "win": {
      "target": "nsis",
      "icon": "../web/src/app/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
